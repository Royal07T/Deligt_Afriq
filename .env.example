APP_NAME="Delight Afriq"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delight_afriq
DB_USERNAME=delight_afriq_user
DB_PASSWORD=replace-with-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_ADDRESS="hello@your-domain.example"
MAIL_FROM_NAME="Delight Afriq"

SUPER_ADMIN_NAME="Delight Afriq Administrator"
SUPER_ADMIN_EMAIL="admin@your-domain.example"
SUPER_ADMIN_PASSWORD=replace-with-strong-password

PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=replace-with-paystack-public-key
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_WEBHOOK_SECRET=replace-with-whsec-webhook-secret
PAYSTACK_MODE=test
PAYMENT_WHATSAPP_ENABLED=true
PAYMENT_PAYSTACK_ENABLED=false

STORE_CURRENCY=NGN
STORE_SHIPPING_FLAT_FEE=2500
STORE_FREE_SHIPPING_THRESHOLD=150000
SECURE_COOKIES=true
FORCE_HTTPS=true
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
